# Copia este archivo como .env y rellena tus valores reales
# NUNCA subas el archivo .env real a GitHub

# Token de tu bot, lo obtienes hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# Tu API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=tu_api_key_aqui

# Chat ID donde quieres recibir avisos de consultas escaladas (opcional)
# Puedes obtenerlo hablando con @userinfobot en Telegram
HUMAN_NOTIFY_CHAT_ID=
